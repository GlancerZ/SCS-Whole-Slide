diff --git a/src/spateo_compat.py b/src/spateo_compat.py
new file mode 100644
index 0000000..1d361d7
--- /dev/null
+++ b/src/spateo_compat.py
@@ -0,0 +1,158 @@
+"""Small Spateo 1.0.2 compatibility layer used by SCS.
+
+The upstream Spateo package imports a very large analysis stack at import time.
+SCS only needs a handful of its 2-D image/segmentation operations.  Keeping the
+implementations here makes the published SCS pipeline usable with its historical
+Python environment without pulling unrelated 3-D, GIS, and single-cell tools.
+"""
+
+from types import SimpleNamespace
+
+import cv2
+import numpy as np
+import pandas as pd
+from anndata import AnnData
+from scipy.sparse import csr_matrix, issparse
+from skimage import color, feature, filters, segmentation
+from tifffile import imread
+
+
+def _circle(k):
+    if k < 1 or k % 2 == 0:
+        raise ValueError("kernel size must be an odd positive integer")
+    radius = (k - 1) // 2
+    return cv2.circle(np.zeros((k, k), dtype=np.uint8), (radius, radius), radius, 1, -1)
+
+
+def _mclose_mopen(mask, k):
+    kernel = _circle(k)
+    closed = cv2.morphologyEx(mask.astype(np.uint8), cv2.MORPH_CLOSE, kernel)
+    return cv2.morphologyEx(closed, cv2.MORPH_OPEN, kernel).astype(bool)
+
+
+def read_bgi_agg(path, stain_path=None, prealigned=False):
+    data = pd.read_csv(path, sep="\t", comment="#")
+    column_aliases = {
+        "gene": ("geneID", "gene", "geneName"),
+        "x": ("x", "row"),
+        "y": ("y", "column", "col"),
+        "count": ("MIDCounts", "MIDCount", "UMICount", "UMICounts", "counts", "count"),
+    }
+    selected = {}
+    for canonical, aliases in column_aliases.items():
+        selected[canonical] = next((name for name in aliases if name in data.columns), None)
+        if selected[canonical] is None:
+            raise ValueError(f"Could not find the {canonical!r} column in {path}")
+
+    x = data[selected["x"]].to_numpy(dtype=np.int64)
+    y = data[selected["y"]].to_numpy(dtype=np.int64)
+    if prealigned:
+        x = x - x.min()
+        y = y - y.min()
+
+    stain = None
+    if stain_path:
+        stain = imread(stain_path)
+        if stain.ndim == 3:
+            stain = color.rgb2gray(stain)
+        if np.issubdtype(stain.dtype, np.floating):
+            stain = np.clip(stain * 255, 0, 255).astype(np.uint8)
+
+    shape_x = int(x.max()) + 1
+    shape_y = int(y.max()) + 1
+    if stain is not None:
+        shape_x = max(shape_x, stain.shape[0])
+        shape_y = max(shape_y, stain.shape[1])
+    shape = (shape_x, shape_y)
+
+    counts = data[selected["count"]].to_numpy(dtype=np.uint16)
+    matrix = csr_matrix((counts, (x, y)), shape=shape, dtype=np.uint16)
+    layers = {}
+    if stain is not None:
+        padded = np.zeros(shape, dtype=stain.dtype)
+        padded[: stain.shape[0], : stain.shape[1]] = stain[: shape[0], : shape[1]]
+        layers["stain"] = padded
+    return AnnData(X=matrix, layers=layers)
+
+
+def refine_alignment(*_args, **_kwargs):
+    raise RuntimeError("This run uses the registered RPI image; additional alignment is disabled.")
+
+
+def imshow(adata, layer, ax=None, labels=False, **kwargs):
+    import matplotlib.pyplot as plt
+
+    kwargs.pop("use_scale", None)
+    kwargs.pop("save_show_or_return", None)
+    matrix = adata.layers[layer]
+    if issparse(matrix):
+        matrix = matrix.toarray()
+    if labels:
+        matrix = color.label2rgb(matrix, bg_label=0)
+    if ax is None:
+        _, ax = plt.subplots(figsize=(5, 5), tight_layout=True)
+    ax.imshow(matrix, interpolation="none", **kwargs)
+    ax.set_title(layer)
+    return ax.get_figure(), ax
+
+
+def mask_nuclei_from_stain(
+    adata,
+    otsu_classes=3,
+    otsu_index=0,
+    local_k=55,
+    offset=5,
+    mk=5,
+    layer="stain",
+    out_layer=None,
+):
+    image = np.asarray(adata.layers[layer])
+    thresholds = filters.threshold_multiotsu(image, otsu_classes)
+    background_mask = image < thresholds[otsu_index]
+    if image.dtype == np.uint8:
+        local_mask = cv2.adaptiveThreshold(
+            image,
+            1,
+            cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
+            cv2.THRESH_BINARY,
+            local_k,
+            -offset,
+        ).astype(bool)
+    else:
+        local_mask = image > filters.threshold_local(
+            image, block_size=local_k, method="gaussian", offset=-offset
+        )
+    adata.layers[out_layer or f"{layer}_mask"] = _mclose_mopen((~background_mask) & local_mask, mk)
+
+
+def find_peaks_from_mask(adata, layer, min_distance, distances_layer=None, markers_layer=None):
+    mask_layer = f"{layer}_mask" if f"{layer}_mask" in adata.layers else layer
+    mask = np.asarray(adata.layers[mask_layer], dtype=bool)
+    distances = cv2.distanceTransform(mask.astype(np.uint8), cv2.DIST_L2, 3)
